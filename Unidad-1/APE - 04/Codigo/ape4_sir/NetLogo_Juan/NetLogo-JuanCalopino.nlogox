<?xml version="1.0" encoding="utf-8"?><model version="NetLogo 7.0.4" snapToGrid="false" nlw-version="2.16.1 (e3e5ed7a)">
  <code><![CDATA[
extensions [fetch csv]

globals [
  beta
  gamma-recuperacion
  poblacion-total
  infectados-iniciales
  tiempo-maximo
  datos-python
  python-cargado?
]

turtles-own [
  estado
  proximo-estado
]

; ==========================================
; 1. INICIALIZACION DEL MODELO SIR
; ==========================================

to setup
  clear-all
  random-seed 42

  set beta 0.30
  set gamma-recuperacion 0.10
  set poblacion-total 100
  set infectados-iniciales 5
  set tiempo-maximo 100

  set datos-python []
  set python-cargado? false

  create-turtles poblacion-total [
    setxy random-xcor random-ycor
    set estado "S"
    set proximo-estado "S"
    set color blue
    set shape "person"
    set size 1.5
  ]

  ask n-of infectados-iniciales turtles [
    set estado "I"
    set proximo-estado "I"
    set color red
  ]

  reset-ticks
end

; ==========================================
; 2. MOTOR DE SIMULACION SIR
; ==========================================

to go
  if ticks >= tiempo-maximo [ stop ]

  ; Copiar estados actuales
  ask turtles [
    set proximo-estado estado
  ]

  ; Contagios probabilisticos
  ask turtles with [estado = "I"] [
    let contacto one-of other turtles

    if contacto != nobody [
      if [estado] of contacto = "S" [
        if random-float 1 < beta [
          ask contacto [
            set proximo-estado "I"
          ]
        ]
      ]
    ]
  ]

  ; Recuperaciones probabilisticas
  ask turtles with [estado = "I"] [
    if random-float 1 < gamma-recuperacion [
      set proximo-estado "R"
    ]
  ]

  ; Aplicar cambios de estado
  ask turtles [
    set estado proximo-estado

    if estado = "S" [ set color blue ]
    if estado = "I" [ set color red ]
    if estado = "R" [ set color green ]
  ]

  tick

  ; Pausa visual de 1.5 segundos
  wait 1.5
end

; ==========================================
; 3. CONTADORES
; ==========================================

to-report susceptibles
  report count turtles with [estado = "S"]
end

to-report infectados
  report count turtles with [estado = "I"]
end

to-report recuperados
  report count turtles with [estado = "R"]
end

; ==========================================
; 4. IMPORTACION DE PYTHON
; ==========================================

to cargar-python
  fetch:user-file-async [ contenido ->

    if contenido != false [

      let filas csv:from-string contenido

      ifelse length filas > 1 [

        let encabezado first filas

        ifelse encabezado =
          (list "tiempo" "susceptibles" "infectados" "recuperados") [

          set datos-python but-first filas
          set python-cargado? true

          ; Dibujar las 3 comparaciones
          dibujar-python

          ; Dibujar SIR completo de Python
          dibujar-sir-python

          user-message (word
            "Archivo CSV cargado correctamente. "
            "Registros: " length datos-python)

        ] [
          user-message "Error: encabezados incorrectos."
        ]

      ] [
        user-message "Error: archivo CSV vacio."
      ]

    ]
  ]
end

; ==========================================
; 5. GRAFICAS COMPARATIVAS
; ==========================================

to dibujar-python
  if not python-cargado? [ stop ]

  ; Comparacion de susceptibles
  set-current-plot "Comparacion susceptibles"
  set-current-plot-pen "python"
  plot-pen-reset

  foreach datos-python [ fila ->
    plotxy (item 0 fila) (item 1 fila)
  ]

  ; Comparacion de infectados
  set-current-plot "Comparacion infectados"
  set-current-plot-pen "python"
  plot-pen-reset

  foreach datos-python [ fila ->
    plotxy (item 0 fila) (item 2 fila)
  ]

  ; Comparacion de recuperados
  set-current-plot "Comparacion recuperados"
  set-current-plot-pen "python"
  plot-pen-reset

  foreach datos-python [ fila ->
    plotxy (item 0 fila) (item 3 fila)
  ]
end

; ==========================================
; 6. GRAFICA GENERAL SIR PYTHON
; ==========================================

to dibujar-sir-python
  if not python-cargado? [ stop ]

  set-current-plot "SIR PYTHON"

  ; Susceptibles
  set-current-plot-pen "S"
  plot-pen-reset

  foreach datos-python [ fila ->
    plotxy (item 0 fila) (item 1 fila)
  ]

  ; Infectados
  set-current-plot-pen "I"
  plot-pen-reset

  foreach datos-python [ fila ->
    plotxy (item 0 fila) (item 2 fila)
  ]

  ; Recuperados
  set-current-plot-pen "R"
  plot-pen-reset

  foreach datos-python [ fila ->
    plotxy (item 0 fila) (item 3 fila)
  ]
end
]]></code>
